---
import { languages, defaultLang } from "../../utils/i18n";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

import Pheader from "../../components/common/Pheader.astro";
import WhoAmI from "../../components/WhoAmI.astro";
import EngineeringPhilosophy from "../../components/EngineeringPhilosophy.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <main
    class="flex flex-col items-center bg-[#0d1117] text-white min-h-screen px-4"
  >
    <Pheader text="ABOUT ME" />
    <WhoAmI />
    <EngineeringPhilosophy />
  </main>
</Layout>
