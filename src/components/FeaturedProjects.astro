---
import { getLangFromUrl, useTranslations } from "../utils/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const techList = [
  "java",
  "springboot",
  "kotlin",
  "mongodb",
  "maven",
  "panama",
  "go",
  "docker",
] as const;
type Tech = (typeof techList)[number];

export interface Props {
  limit?: number;
  variant?: "cards" | "list";
}

const { limit, variant = "cards" } = Astro.props;

type Project = {
  title: string;
  description: string;
  image: string;
  link: string;
  technologies: Tech[];
};

const projects: Project[] = [
  {
    title: "Pseudorandomometric Sequences Api",
    description: t("projects.p1.desc"),
    image: "/images/projects/pseudorandomometric.png",
    link: "https://github.com/RedRiotTank/PseudorandomometricSequencesApi",
    technologies: ["kotlin", "springboot"],
  },
  {
    title: "Native Json Navigator",
    description: t("projects.p2.desc"),
    image: "/images/projects/nativejsonnavigator.png",
    link: "https://github.com/RedRiotTank/NativeJsonNavigator",
    technologies: ["java", "panama"],
  },
  {
    title: "RedBlockChain-Core",
    description: t("projects.p3.desc"),
    image: "/images/projects/placeholder.svg",
    link: "https://github.com/RedRiotTank/RedBlockChain-core",
    technologies: ["java", "maven", "mongodb"],
  },
  {
    title: "Fiscus",
    description: t("projects.p4.desc"),
    image: "/images/projects/fiscus-brand.png",
    link: "https://github.com/RedRiotTank/Fiscus",
    technologies: ["go", "docker"],
  },
];

const displayedProjects = limit ? projects.slice(0, limit) : projects;

const techIcons: Record<Tech, string> = {
  java: "/images/stack/java.png",
  springboot: "/images/stack/springboot.svg",
  kotlin: "/images/stack/kotlin.png",
  mongodb: "/images/stack/mongodb.png",
  maven: "/images/stack/maven.png",
  panama: "/images/stack/panama.png",
  go: "/images/stack/go.png",
  docker: "/images/stack/docker.png",
};

var text = limit ? t("projects.selection") : t("projects.some");
const isHome = variant === "cards" && limit !== undefined;
---

<section class={isHome ? "flex min-h-screen flex-col justify-center py-10" : "py-10"}>
  <div class={isHome ? "mx-auto w-full max-w-5xl px-4" : "mx-auto max-w-7xl px-4"}>
    <h3 class="text-4xl font-bold text-center text-white mb-12">
      {text}
    </h3>

    {
      variant === "list" ? (
        <div class="flex flex-col gap-4">
          {displayedProjects.map((project) => (
            <a
              href={project.link}
              class="group flex flex-col gap-5 rounded-2xl border border-white/10 bg-gray-900/70 p-6 transition-colors hover:border-white/20 hover:bg-white/[0.04] sm:flex-row sm:items-center"
            >
              <div class="flex w-40 shrink-0 flex-col items-center gap-3 sm:w-56">
                <div class="flex h-32 w-32 items-center justify-center sm:h-40 sm:w-48">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <h4 class="w-full break-words px-2 text-center text-sm font-semibold leading-snug text-white">
                  {project.title}
                </h4>
              </div>

              <p class="flex-1 text-sm text-gray-300">
                {project.description}
              </p>

              <div class="flex shrink-0 flex-wrap justify-end gap-2">
                {project.technologies.map((tech) => (
                  <img
                    src={techIcons[tech]}
                    alt={tech}
                    title={tech}
                    class="h-6 w-6 opacity-80 transition hover:opacity-100"
                  />
                ))}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class={isHome ? "mx-auto grid max-w-4xl gap-8 md:grid-cols-2" : "grid gap-8 xl:grid-cols-3"}>
          {displayedProjects.map((project) => (
            <a
              href={project.link}
              class="group relative flex min-h-[350px] flex-col overflow-hidden rounded-2xl bg-gray-900 shadow-lg transition duration-300 hover:scale-[1.01] hover:shadow-pink-600/30"
            >
              <div class="flex h-48 items-center justify-center bg-gradient-to-br from-gray-800/80 to-gray-900 p-8">
                <img
                  src={project.image}
                  alt={project.title}
                  class="max-h-full max-w-full object-contain transition duration-300 group-hover:scale-105"
                />
              </div>
              <div class="p-6 pb-16">
                <h4 class="mb-2 text-xl font-semibold text-white">
                  {project.title}
                </h4>
                <p class="text-gray-300">{project.description}</p>
              </div>

              <div class="absolute bottom-6 right-6 flex flex-wrap justify-end gap-2">
                {project.technologies.map((tech) => (
                  <img
                    src={techIcons[tech]}
                    alt={tech}
                    title={tech}
                    class="h-6 w-6 opacity-80 transition hover:opacity-100"
                  />
                ))}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
