---
const techStack = [
  { name: "Java", logo: "/images/stack/java.png" },
  { name: "Kotlin", logo: "/images/stack/kotlin.png" },
  { name: "Spring Boot", logo: "/images/stack/springboot.svg" },
  { name: "Kafka", logo: "/images/stack/kafka.webp" },
  { name: "PostgreSQL", logo: "/images/stack/postgre.png" },
  { name: "Redis", logo: "/images/stack/redis.png" },
  { name: "Docker", logo: "/images/stack/docker.png" },
  { name: "Google Cloud", logo: "/images/stack/gcp.png" },
  { name: "AWS", logo: "/images/stack/aws.png" },
  { name: "Linux", logo: "/images/stack/linux.svg" },
];
---

<section class="py-12 px-4">
  <div class="text-center mb-8">
    <span
      class="inline-block px-3 py-1 mb-2 text-xs font-mono font-semibold tracking-wider text-cyan-400 uppercase bg-cyan-950/60 border border-cyan-800/50 rounded-full shadow-inner"
    >
      // CORE_CAPABILITIES
    </span>
    <h2 class="text-3xl font-bold tracking-tight text-white font-mono">
      Tech Stack
    </h2>
  </div>

  <div class="mx-auto max-w-5xl">
    <div
      class="grid grid-cols-3 sm:grid-cols-5 gap-6"
    >
      {
        techStack.map((tech) => (
          <div class="group flex flex-col items-center justify-center p-3 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.06] hover:border-white/15 transition-all duration-200">
            <img
              src={tech.logo}
              alt={tech.name}
              class="w-10 h-10 sm:w-12 sm:h-12 object-contain mb-2 transition-transform duration-200 group-hover:scale-110"
              loading="lazy"
            />
            <span class="text-xs font-medium text-neutral-300 text-center font-mono group-hover:text-white transition-colors">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
